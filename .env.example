# URL pública canónica del sitio (sin barra final).
# Usada por metadata, sitemap, robots y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://illuyankalabs.com

# Formulario de contacto — envío vía Resend (https://resend.com).
# Sin estas variables, en producción el formulario muestra el correo como alternativa.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej. "Sitio web <web@illuyankalabs.com>".
CONTACT_FROM_EMAIL=
# Buzón que recibe las solicitudes (por defecto, el correo de contacto del sitio).
CONTACT_TO_EMAIL=
